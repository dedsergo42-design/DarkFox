// Ресурсы лоадера DarkFox.
//
// Манифест -- главное: именно он даёт запрос прав администратора при старте.
// Встраивается как RT_MANIFEST (24) с id 1 (CREATEPROCESS_MANIFEST_RESOURCE_ID),
// это единственный id, который Windows читает для EXE-файлов. Любой другой
// номер ресурса будет проигнорирован, и лоадер стартует без UAC.
//
// Иконки идут под id 1 (IDI_ICON1): его Windows берёт как иконку файла в
// проводнике и в панели задач. Группа иконок собирается из .ico целиком,
// поэтому размеры 16..256 внутри файла переключаются системой автоматически.
//
// Макрос DARKFOX_DEV_ICON выбирает вариант: у дев-сборки янтарная иконка с
// кольцом, чтобы лоадеры различались в панели задач на глаз.

#include <windows.h>

#ifdef DARKFOX_DEV_ICON
1 ICON "icon_dev.ico"
#else
1 ICON "icon_normal.ico"
#endif

1 RT_MANIFEST "loader.manifest"
